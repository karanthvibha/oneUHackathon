# Amazon Bedrock configuration
# Copy this file to backend/.env and fill in your values.

# AWS region to use for Bedrock.
BEDROCK_REGION=us-west-2

# Preferred Bedrock model ID.
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# --- Credentials: use exactly one of the two options below ---

# Option A: Long-lived access keys (NOT recommended for production).
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# Option B (recommended): Leave the above empty and rely on your
# environment's default AWS credential chain. For example, set these in
# your shell/CI or run with an IAM role:
#   - AWS_PROFILE
#   - AWS_WEB_IDENTITY_TOKEN_FILE / AWS_ROLE_ARN (EKS IRSA, GitHub OIDC, etc.)

# CORS origins the backend accepts (comma-separated).
CORS_ORIGINS=http://localhost:5173

# Flask options
PORT=5001
FLASK_DEBUG=0