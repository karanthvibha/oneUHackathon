# All model + Amazon Bedrock settings live here (not in the UI).
# Copy this file to backend/.env and fill in your values.

# The model used by BOTH the AI Tutor and Smart Notes.
# Served through Bedrock's OpenAI-compatible API.
TUTOR_MODEL_ID=openai.gpt-oss-120b

# Bedrock OpenAI-compatible endpoint for your region.
OPENAI_BASE_URL=https://bedrock-runtime.us-west-2.amazonaws.com/api/openai

# Your Amazon Bedrock API key (Bedrock console → API keys).
# This is the single credential the whole backend uses.
OPENAI_API_KEY=

# Folder (relative to where you run the backend) containing course PDFs
# used by the tutor's local retrieval.
# TUTOR_MATERIALS_FOLDER=course_materials

# CORS origins the backend accepts (comma-separated).
CORS_ORIGINS=http://localhost:5173

# Flask options
PORT=5001
FLASK_DEBUG=0